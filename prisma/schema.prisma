generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  COMERCIAL
  OPERACAO
  FINANCEIRO
}

enum CanalOrigem {
  EMAIL
  SITE
  WHATSAPP
  INDICACAO
}

enum TipoEvento {
  CRIACAO
  MUDANCA_ETAPA
  NOTA
  ATUALIZACAO
  ANEXO
}

model Usuario {
  id           String     @id @default(cuid())
  nome         String
  email        String     @unique
  senhaHash    String
  papel        Papel
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  processos    Processo[] @relation("Responsavel")
  eventos      Evento[]
  anexos       Anexo[]
  chaves       ChaveApi[]
  conversasWhatsapp ConversaWhatsapp[] @relation("ResponsavelWhatsapp")
  tarefas          Tarefa[]
}

model ChaveApi {
  id          String    @id @default(cuid())
  nome        String
  prefixo     String
  hash        String    @unique
  exemplo     Boolean   @default(false)
  criadaEm    DateTime  @default(now())
  revogadaEm  DateTime?
  ultimoUsoEm DateTime?
  criadaPorId String
  criadaPor   Usuario   @relation(fields: [criadaPorId], references: [id])
}

model Cliente {
  id           String     @id @default(cuid())
  nome         String
  cnpj         String?    @unique
  email        String?
  telefone     String?
  endereco     String?
  cidade       String?
  uf           String?
  observacoes  String?
  inscricaoEstadual String?
  site         String?
  kommoId      String?    @unique
  extras       Json?
  exemplo      Boolean    @default(false)
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  contatos     Contato[]
  processos    Processo[]
}

model Contato {
  id        String     @id @default(cuid())
  clienteId String
  cliente   Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome      String
  email     String?
  telefone  String?
  cargo     String?
  cpf       String?
  documento String?
  kommoId   String?    @unique
  extras    Json?
  principal Boolean    @default(false)
  criadoEm  DateTime   @default(now())
  processos Processo[]
  conversasWhatsapp ConversaWhatsapp[]
}

model Processo {
  id              String       @id @default(cuid())
  codigo          String       @unique
  titulo          String
  etapa           String       @default("LEADS_DE_ENTRADA")
  kommoId         String?      @unique
  extras          Json?
  canal           CanalOrigem
  documentoFiscal       String?
  documentoFiscalManual Boolean      @default(false)
  clienteId       String
  cliente         Cliente      @relation(fields: [clienteId], references: [id])
  contatoId       String?
  contato         Contato?     @relation(fields: [contatoId], references: [id])
  colaborador     String?
  origemEndereco  String?
  origemCidade    String?
  origemUf        String?
  origemReferencia String?
  origemAndar     String?
  origemElevador  String?
  origemImovel    String?
  destinoEndereco String?
  destinoCidade   String?
  destinoUf       String?
  destinoReferencia String?
  destinoAndar    String?
  destinoElevador String?
  destinoImovel   String?
  modalidade      String?
  descricaoColeta String?
  descricaoEntrega String?
  embalagemNecessaria Boolean?
  volume          String?
  itensEspeciais  String?      @db.Text
  dataPretendida  DateTime?    @db.Date
  dataColeta      DateTime?    @db.Date
  dataEntrega     DateTime?    @db.Date
  dataPrevista    DateTime?    @db.Date
  dataEmissao     DateTime?    @db.Date
  diasParaColetar Int?
  diasParaViagem  Int?
  motoristaNome   String?
  motoristaPlaca  String?
  motoristaAntt   String?
  motoristaCnh    String?
  motoristaCpf    String?
  inventario      String?      @db.Text
  valorCotado     Decimal?     @db.Decimal(12, 2)
  valorAprovado   Decimal?     @db.Decimal(12, 2)
  valorFrete      Decimal?     @db.Decimal(12, 2)
  valorSeguro     Decimal?     @db.Decimal(12, 2)
  valorTransporte Decimal?     @db.Decimal(12, 2)
  valorTotal      Decimal?     @db.Decimal(12, 2)
  formaPagamento  String?
  validadeProposta DateTime?   @db.Date
  linkProposta    String?
  linkContrato    String?
  linkContratoCarreteiro String?
  linkOs          String?
  linkRecibo      String?
  fonte           String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  fbclid          String?
  gclid           String?
  metaCampaignId  String?
  metaAdId        String?
  referrer        String?
  formulario      String?
  numeroOc        String?
  numeroCte       String?
  numeroNf        String?
  dataVencimento  DateTime?    @db.Date
  dataRecebimento DateTime?    @db.Date
  responsavelId   String?
  responsavel     Usuario?     @relation("Responsavel", fields: [responsavelId], references: [id])
  exemplo         Boolean      @default(false)
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
  eventos         Evento[]
  anexos          Anexo[]
  conversasWhatsapp ConversaWhatsapp[]
  tarefas         Tarefa[]
  itensInventario ItemInventario[]
  ctes            Cte[]
  mdfes           Mdfe[]
  nfses           Nfse[]

  @@index([etapa])
  @@index([clienteId])
  @@index([responsavelId])
  @@index([dataColeta])
  @@index([dataVencimento])
}

model Evento {
  id         String     @id @default(cuid())
  processoId String
  processo   Processo   @relation(fields: [processoId], references: [id], onDelete: Cascade)
  tipo       TipoEvento
  mensagem   String     @db.Text
  etapaDe    String?
  etapaPara  String?
  usuarioId  String?
  usuario    Usuario?   @relation(fields: [usuarioId], references: [id])
  origem     String
  criadoEm   DateTime   @default(now())

  @@index([processoId, criadoEm])
}

model EtapaPipeline {
  id           String   @id
  slug         String   @unique
  rotulo       String
  resumo       String   @default("")
  cor          String
  ordem        Int
  grupo        String
  terminal     Boolean  @default(false)
  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model CampoPersonalizado {
  id        String   @id @default(cuid())
  entidade  String
  chave     String
  rotulo    String
  tipo      String   @default("TEXTO")
  criadoEm  DateTime @default(now())

  @@unique([entidade, chave])
}

model TipoTarefa {
  id      String       @id
  slug    String       @unique
  rotulo  String
  ativo   Boolean      @default(true)
  regras  RegraTarefa[]
  tarefas Tarefa[]
}

model RegraTarefa {
  id          String     @id @default(cuid())
  etapaSlug   String
  tipoId      String
  tipo        TipoTarefa @relation(fields: [tipoId], references: [id])
  titulo      String
  horasDepois Int        @default(24)
  ativa       Boolean    @default(true)

  @@unique([etapaSlug, tipoId])
}

model Tarefa {
  id            String     @id @default(cuid())
  processoId    String
  processo      Processo   @relation(fields: [processoId], references: [id], onDelete: Cascade)
  tipoId        String
  tipo          TipoTarefa @relation(fields: [tipoId], references: [id])
  titulo        String
  descricao     String?
  responsavelId String?
  responsavel   Usuario?   @relation(fields: [responsavelId], references: [id])
  vencimento    DateTime
  concluidaEm   DateTime?
  automatica    Boolean    @default(false)
  criadoEm      DateTime   @default(now())

  @@index([vencimento])
  @@index([responsavelId])
  @@index([processoId])
}

model ItemCatalogo {
  id        String           @id @default(cuid())
  nome      String
  categoria String
  volumeM3  Decimal          @db.Decimal(8, 3)
  ativo     Boolean          @default(true)
  ordem     Int              @default(0)
  itens     ItemInventario[]
}

model ItemInventario {
  id              String        @id @default(cuid())
  processoId      String
  processo        Processo      @relation(fields: [processoId], references: [id], onDelete: Cascade)
  catalogoId      String?
  catalogo        ItemCatalogo? @relation(fields: [catalogoId], references: [id])
  nome            String
  comodo          String
  quantidade      Int           @default(1)
  volumeUnitario  Decimal       @db.Decimal(8, 3)
  fragil          Boolean       @default(false)
  desmontagem     Boolean       @default(false)
  embalagem       Boolean       @default(false)
  personalizado   Boolean       @default(false)
  criadoEm        DateTime      @default(now())
}

model Cte {
  id                      String    @id @default(cuid())
  processoId              String
  processo                Processo  @relation(fields: [processoId], references: [id], onDelete: Cascade)
  status                  String    @default("RASCUNHO")
  finalidade              Int       @default(0)
  tipoServico             Int       @default(0)
  indicadorTomador        Int       @default(0)
  contribuicaoTomador     Int       @default(9)
  classificacaoTributaria String?
  regimeTributario        String?
  partilhaIcms            Boolean   @default(false)
  uuidProvedor            String?
  rascunho                Json?
  pedidoPreparado         Json?
  mensagemProvedor        String?
  emitenteNome            String?
  emitenteDocumento       String?
  emitenteIe              String?
  emitenteMunicipio       String?
  emitenteUf              String?
  remetenteNome           String?
  remetenteDocumento      String?
  remetenteMunicipio      String?
  remetenteUf             String?
  destinatarioNome        String?
  destinatarioDocumento   String?
  destinatarioMunicipio   String?
  destinatarioUf          String?
  expedidorNome           String?
  expedidorDocumento      String?
  recebedorNome           String?
  recebedorDocumento      String?
  tomador                 String    @default("REMETENTE")
  cfop                    String?
  naturezaOperacao        String?
  modal                   String    @default("01")
  municipioInicio         String?
  ufInicio                String?
  municipioFim            String?
  ufFim                   String?
  valorPrestacao          Decimal?  @db.Decimal(12, 2)
  componentes             Json?
  icmsCst                 String?
  icmsBase                Decimal?  @db.Decimal(12, 2)
  icmsAliquota            Decimal?  @db.Decimal(6, 2)
  icmsValor               Decimal?  @db.Decimal(12, 2)
  produtoPredominante     String?
  valorCarga              Decimal?  @db.Decimal(12, 2)
  quantidadeCarga         Decimal?  @db.Decimal(12, 3)
  unidadeCarga            String?   @default("M3")
  rntrc                   String?
  documentos              Json?
  chave                   String?
  numero                  String?
  serie                   String?
  xmlUrl                  String?
  dacteUrl                String?
  provedor                String?
  criadoEm                DateTime  @default(now())
  atualizadoEm            DateTime  @updatedAt
  manifestos              MdfeCte[]

  @@index([processoId])
  @@index([chave])
}

model Mdfe {
  id                         String    @id @default(cuid())
  processoId                 String
  processo                   Processo  @relation(fields: [processoId], references: [id], onDelete: Cascade)
  status                     String    @default("RASCUNHO")
  modalidade                 Int       @default(1)
  ufInicio                   String?
  ufFim                      String?
  percurso                   String?
  municipioCarregamento      String?
  municipioDescarregamento   String?
  placa                      String?
  renavam                    String?
  taraKg                     Int?
  capacidadeKg               Int?
  capacidadeM3               Int?
  condutorNome               String?
  condutorCpf                String?
  rntrc                      String?
  seguradoraNome             String?
  seguradoraCnpj             String?
  apolice                    String?
  averbacao                  String?
  valorCarga                 Decimal?  @db.Decimal(12, 2)
  pesoBruto                  Decimal?  @db.Decimal(12, 4)
  chave                      String?
  numero                     String?
  serie                      String?
  uuidProvedor               String?
  xmlUrl                     String?
  damdfeUrl                  String?
  pedidoPreparado            Json?
  mensagemProvedor           String?
  criadoEm                   DateTime  @default(now())
  atualizadoEm               DateTime  @updatedAt
  documentos                 MdfeCte[]

  @@index([processoId])
  @@index([chave])
}

model MdfeCte {
  id     String @id @default(cuid())
  mdfeId String
  mdfe   Mdfe   @relation(fields: [mdfeId], references: [id], onDelete: Cascade)
  cteId  String
  cte    Cte    @relation(fields: [cteId], references: [id], onDelete: Cascade)

  @@unique([mdfeId, cteId])
}

model CodigoServicoNfse {
  id          String   @id @default(cuid())
  codigo      String   @unique
  descricao   String
  cnae        String?
  aliquotaIss Decimal? @db.Decimal(6, 2)
  padrao      Boolean  @default(false)
  ativo       Boolean  @default(true)
}

model Nfse {
  id                  String    @id @default(cuid())
  processoId          String
  processo            Processo  @relation(fields: [processoId], references: [id], onDelete: Cascade)
  status              String    @default("RASCUNHO")
  prestadorNome       String?
  prestadorDocumento  String?
  prestadorMunicipio  String?
  prestadorUf         String?
  prestadorIbge       String?
  tomadorNome         String?
  tomadorDocumento    String?
  tomadorEmail        String?
  tomadorEndereco     String?
  tomadorNumero       String?
  tomadorBairro       String?
  tomadorCidade       String?
  tomadorUf           String?
  tomadorCep          String?
  municipioPrestacao  String?
  ufPrestacao         String?
  discriminacao       String?   @db.Text
  codigoServico       String?
  cnae                String?
  aliquotaIss         Decimal?  @db.Decimal(6, 2)
  valorIss            Decimal?  @db.Decimal(12, 2)
  issRetido           Boolean   @default(false)
  aliquotaPis         Decimal?  @db.Decimal(6, 2)
  aliquotaCofins      Decimal?  @db.Decimal(6, 2)
  aliquotaCsll        Decimal?  @db.Decimal(6, 2)
  aliquotaIr          Decimal?  @db.Decimal(6, 2)
  aliquotaInss        Decimal?  @db.Decimal(6, 2)
  valorServicos       Decimal?  @db.Decimal(12, 2)
  deducoes            Decimal?  @db.Decimal(12, 2)
  ibsSituacao         String?
  ibsClassificacao    String?
  numero              String?
  codigoVerificacao   String?
  serieRps            String?
  numeroRps           String?
  uuidProvedor        String?
  pdfUrl              String?
  xmlUrl              String?
  pedidoPreparado     Json?
  mensagemProvedor    String?
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  @@index([processoId])
  @@index([uuidProvedor])
}

model Empresa {
  id           String   @id @default("padrao")
  nome         String?
  cnpj         String?
  ie           String?
  municipio    String   @default("Goiânia")
  uf           String   @default("GO")
  codigoIbge   String   @default("5208707")
  atualizadoEm DateTime @updatedAt
}

model ConfigWhatsapp {
  id           String   @id @default("padrao")
  verifyToken  String?
  appSecret    String?
  accessToken  String?
  wabaId       String?
  appId        String?
  embeddedSignupConfigId String?
  apiVersion   String   @default("v21.0")
  atualizadoEm DateTime @updatedAt
}

model NumeroWhatsapp {
  id             String             @id @default(cuid())
  nome           String
  phoneNumberId  String             @unique
  numeroExibicao String
  accessToken    String?
  wabaId         String?
  ativo          Boolean            @default(true)
  exemplo        Boolean            @default(false)
  coexistencia   Boolean            @default(false)
  coexistenciaAtivadoEm DateTime?
  historicoSolicitadoEm DateTime?
  historicoStatus String?
  historicoProgresso Int?
  historicoErro  String?
  criadoEm       DateTime           @default(now())
  atualizadoEm   DateTime           @updatedAt
  conversas      ConversaWhatsapp[]
}

model ConversaWhatsapp {
  id                 String             @id @default(cuid())
  numeroId           String
  numero             NumeroWhatsapp     @relation(fields: [numeroId], references: [id], onDelete: Cascade)
  waId               String
  nomeContato        String?
  contatoId          String?
  contato            Contato?           @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  processoId         String?
  processo           Processo?          @relation(fields: [processoId], references: [id], onDelete: SetNull)
  responsavelId      String?
  responsavel        Usuario?           @relation("ResponsavelWhatsapp", fields: [responsavelId], references: [id], onDelete: SetNull)
  naoLida            Boolean            @default(true)
  ultimaMensagem     String?
  ultimaMensagemEm   DateTime?
  ultimaEntradaEm    DateTime?
  exemplo            Boolean            @default(false)
  criadoEm           DateTime           @default(now())
  atualizadoEm       DateTime           @updatedAt
  mensagens          MensagemWhatsapp[]

  @@unique([numeroId, waId])
  @@index([naoLida])
  @@index([ultimaMensagemEm])
}

model MensagemWhatsapp {
  id           String                  @id @default(cuid())
  conversaId   String
  conversa     ConversaWhatsapp        @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  wamid        String?                 @unique
  direcao      DirecaoMensagem
  tipo         TipoMensagemWhatsapp
  texto        String?                 @db.Text
  midiaId      String?
  midiaMime    String?
  midiaNome    String?
  status       StatusMensagemWhatsapp
  erro         String?
  criadaEm     DateTime
  registradaEm DateTime                @default(now())

  @@index([conversaId, criadaEm])
}

enum DirecaoMensagem {
  ENTRADA
  SAIDA
}

enum TipoMensagemWhatsapp {
  TEXTO
  IMAGEM
  AUDIO
  VIDEO
  DOCUMENTO
  FIGURINHA
  LOCALIZACAO
  MODELO
  INTERATIVA
  DESCONHECIDO
}

enum StatusMensagemWhatsapp {
  RECEBIDA
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
}

model Anexo {
  id          String   @id @default(cuid())
  processoId  String
  processo    Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  nomeArquivo String
  tipoMime    String
  tamanho     Int
  conteudo    Bytes
  usuarioId   String?
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])
  criadoEm    DateTime @default(now())
}
