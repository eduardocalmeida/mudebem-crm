# Postgres local (docker compose) ou Neon/Supabase em produção.
DATABASE_URL="postgresql://mudebem:mudebem@localhost:5432/mudebem?schema=public"

# String longa e aleatória. Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-uma-string-longa-e-aleatoria"

# Banco usado por `npm test`. Não aponte para o banco de desenvolvimento.
TEST_DATABASE_URL="postgresql://mudebem:mudebem@localhost:5432/mudebem_test?schema=public"

# WhatsApp Cloud API (Meta). Segredos do app. Se ficarem vazios, dá para gravá-los em WhatsApp → Números e conexão.
WHATSAPP_APP_ID=""
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WABA_ID=""
WHATSAPP_API_VERSION="v21.0"

# Dois números da mesma WABA. O token de cada um é opcional e, se vazio, usa WHATSAPP_ACCESS_TOKEN.
WHATSAPP_NUMERO_1_ID=""
WHATSAPP_NUMERO_1_NOME="Comercial"
WHATSAPP_NUMERO_1_EXIBICAO="+55 11 0000-0000"
WHATSAPP_NUMERO_1_TOKEN=""
WHATSAPP_NUMERO_2_ID=""
WHATSAPP_NUMERO_2_NOME="Operação"
WHATSAPP_NUMERO_2_EXIBICAO="+55 11 0000-0001"
WHATSAPP_NUMERO_2_TOKEN=""

# CT-e WebmaniaBR API v2. Deixe o token vazio até a homologação. Ambiente 2 = homologação, 1 = produção.
WEBMANIA_ACCESS_TOKEN=""
WEBMANIA_AMBIENTE="2"
WEBMANIA_URL_BASE="https://api.webmania.com.br"
WEBMANIA_URL_NOTIFICACAO=""
WEBMANIA_MDFE_URL_NOTIFICACAO=""
WEBMANIA_NFSE_URL_NOTIFICACAO=""
# municipal envia a alíquota de ISS. padrao_nacional omite impostos.iss.
WEBMANIA_NFSE_MODELO="municipal"
WEBMANIA_WEBHOOK_TOKEN=""
WEBMANIA_EMITENTE_NOME=""
WEBMANIA_EMITENTE_CNPJ=""
WEBMANIA_EMITENTE_IE=""
